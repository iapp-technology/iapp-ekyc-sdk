<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application>
        <!-- Portrait-locked (configChanges guards against WebView recreation
             mid-flow); exported=false — launched only via IappEkycContract. -->
        <activity
            android:name="com.iapp.ekyc.internal.IappEkycActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.IappEkyc.Fullscreen" />
    </application>

</manifest>
